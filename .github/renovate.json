{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "schedule:daily"
  ],
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchManagers": [
        "yarn"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "prPriority": -1,
      "automerge": true
    },
    {
      "description": "Hold typescript on 6.x until ts-jest/typescript-eslint support TS7 (peers: ts-jest <7, typescript-eslint <6.1.0)",
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Disable Node.js major version updates",
      "matchDatasources": [
        "docker",
        "node-version"
      ],
      "matchPackageNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Disable Dockerfile Node.js major version updates",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": false,
  "lockFileMaintenance": {
    "enabled": false
  },
  "automergeStrategy": "squash"
}
